# Production API (APK / real devices):
EXPO_PUBLIC_API_URL=https://aiautomations.work

# Local dev on a physical device (your PC LAN IP from Metro, e.g. exp://192.168.x.x:8081):
# EXPO_PUBLIC_API_URL=http://192.168.31.160:3000

# Same machine (web / iOS simulator):
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Android emulator → host machine:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Google sign-in (same OAuth project as web AUTH_GOOGLE_ID):
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your-android-client-id.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
